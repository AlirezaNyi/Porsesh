# Copy this file to .env and fill in the values before running docker-compose.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# These are used both by the db service and to build the connection URL for web.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=porsesh

# Optional: expose Postgres on a different host port (default 5432)
# POSTGRES_PORT=5432

# Optional: expose the app on a different host port (default 3000)
# APP_PORT=3000

# ── Clerk authentication ───────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
