# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── PostgreSQL (Docker Compose) ────────────────────────────────────────────
# Used by the db service and to build the connection URL for the web service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
POSTGRES_DB=porsesh

# Optional: expose Postgres / app on different host ports (defaults 5432 / 3000)
# POSTGRES_PORT=5432
# APP_PORT=3000

# ── Prisma (local development outside Docker) ──────────────────────────────
# Required when running `npm run dev` against a local Postgres.
# Docker Compose sets POSTGRES_PRISMA_URL for the web service automatically.
POSTGRES_PRISMA_URL=postgresql://postgres:CHANGE_ME_BEFORE_DEPLOY@localhost:5432/porsesh

# ── Clerk authentication ───────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
